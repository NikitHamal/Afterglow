{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC + SDL3",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/win64",
      "cacheVariables": {
        "AG_WITH_SDL": "ON",
        "AG_BUILD_PARITY": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-headless",
      "displayName": "Windows headless (no SDL, parity only)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/headless",
      "cacheVariables": {
        "AG_WITH_SDL": "OFF",
        "AG_BUILD_PARITY": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-headless", "configurePreset": "windows-headless" }
  ]
}
