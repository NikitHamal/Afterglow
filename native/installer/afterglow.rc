// Windows resources: application icon (also GLFW_ICON, so the window and taskbar use it) + version info.
// AG_VER_* / AG_VERSION come from CMake (CI: 0.<run>.0).
#ifndef AG_VER_MAJOR
#define AG_VER_MAJOR 0
#define AG_VER_MINOR 0
#define AG_VER_PATCH 0
#endif
#ifndef AG_VERSION
#define AG_VERSION "0.0.0-dev"
#endif

IDI_ICON1 ICON "afterglow.ico"
GLFW_ICON ICON "afterglow.ico"

1 VERSIONINFO
FILEVERSION AG_VER_MAJOR,AG_VER_MINOR,AG_VER_PATCH,0
PRODUCTVERSION AG_VER_MAJOR,AG_VER_MINOR,AG_VER_PATCH,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Afterglow"
      VALUE "FileDescription", "Afterglow (18+)"
      VALUE "FileVersion", AG_VERSION
      VALUE "ProductName", "Afterglow"
      VALUE "ProductVersion", AG_VERSION
      VALUE "OriginalFilename", "Afterglow.exe"
      VALUE "LegalCopyright", "Adults only. Fiction between consenting adults."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
