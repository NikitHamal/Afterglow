// Windows resources: application icon + version info
IDI_ICON1 ICON "afterglow.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Afterglow"
      VALUE "FileDescription", "Afterglow (18+)"
      VALUE "FileVersion", "0.2.0"
      VALUE "ProductName", "Afterglow"
      VALUE "ProductVersion", "0.2.0"
      VALUE "OriginalFilename", "Afterglow.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
