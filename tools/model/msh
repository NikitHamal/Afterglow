#!/bin/bash
# run a shell command on molab, print output
CMD="$*" python3 - <<'PY' | $(dirname "$0")/mx
import os,json
print("import subprocess\nr=subprocess.run(%s,shell=True,capture_output=True,text=True,executable='/bin/bash')\nprint(r.stdout[-6000:]); print(r.stderr[-3000:])" % json.dumps(os.environ['CMD']))
PY
